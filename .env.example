# Tooling only. Angular browser code has no environment-variable loader.
# Export these explicitly before Playwright; .env is not loaded by npm/Angular.
# Browser API root remains same-origin /api in both Docker deployments.
# These tests mutate DEV fixtures; never run them against production-like data.
QUIZ_E2E_BROWSER_CHANNEL=
QUIZ_E2E_PROJECT=jp_learning_dev
QUIZ_E2E_EXPIRY=0
FLASHCARD_E2E_DEPLOYED=false
